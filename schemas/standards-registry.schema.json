{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abiswas97/bonboncinnabon/schemas/standards-registry.schema.json",
  "title": "Standards supporting-rule registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "class", "lifecycles", "paths", "roles", "reference"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "class": { "enum": ["enforced", "review", "advisory"] },
        "lifecycles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["session", "plan", "edit", "subagent"] }
        },
        "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reference": { "type": "string", "pattern": "^references/[a-z0-9-]+\\.md$" }
      }
    }
  }
}
