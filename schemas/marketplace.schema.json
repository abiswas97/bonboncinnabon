{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abiswas97/bonboncinnabon/schemas/marketplace.schema.json",
  "title": "Bonboncinnabon canonical marketplace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "displayName", "description", "owner", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "hosts"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "enum": ["local", "external"] },
          "path": { "type": "string", "pattern": "^\\./plugins/[a-z0-9-]+$" },
          "hosts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["claude", "codex"] }
          },
          "claudeEntry": { "type": "object" }
        }
      }
    }
  }
}
