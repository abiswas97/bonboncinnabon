{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abiswas97/bonboncinnabon/schemas/plugin.schema.json",
  "title": "Bonboncinnabon canonical local plugin",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hookConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "script", "registrations"],
      "properties": {
        "manifest": { "type": "string", "pattern": "^hooks/[a-z0-9/-]+\\.json$" },
        "script": { "type": "string", "pattern": "^hooks/[a-z0-9/-]+\\.mjs$" },
        "registrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "matcher", "timeout"],
            "properties": {
              "event": { "type": "string", "minLength": 1 },
              "matcher": { "type": "string", "minLength": 1 },
              "timeout": { "type": "integer", "minimum": 1, "maximum": 60 }
            }
          }
        }
      }
    }
  },
  "required": ["schemaVersion", "name", "version", "description", "author", "repository", "license", "category", "tags", "hosts", "components", "interface"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "repository": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "hosts": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "codex"] }, "uniqueItems": true },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "commands", "hooks"],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "displayName", "shortDescription", "defaultPrompt"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "displayName": { "type": "string", "minLength": 1 },
              "shortDescription": { "type": "string", "minLength": 25, "maxLength": 64 },
              "defaultPrompt": { "type": "string", "minLength": 1 }
            }
          }
        },
        "commands": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "hooks": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "claude": { "$ref": "#/$defs/hookConfig" },
                "codex": { "$ref": "#/$defs/hookConfig" }
              }
            }
          ]
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "shortDescription", "longDescription", "developerName", "capabilities", "defaultPrompt"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string", "minLength": 1 },
        "developerName": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "defaultPrompt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
