{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "level", "status", "points", "parent_id", "blocked_by"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "level": { "enum": ["Epic", "Task", "Sub-task"] },
    "status": { "enum": ["Backlog", "To Do", "In Progress", "In Review", "Blocked", "Done", "Won't Do"] },
    "points": { "type": ["integer", "null"], "enum": [null, 1, 2, 3, 5] },
    "parent_id": { "type": ["string", "null"] },
    "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
