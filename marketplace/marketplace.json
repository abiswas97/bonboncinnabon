{
  "schemaVersion": 1,
  "name": "bonboncinnabon",
  "displayName": "Bonboncinnabon",
  "description": "Portable Claude and Codex plugins by bonboncinnabon",
  "owner": {
    "name": "bonboncinnabon"
  },
  "plugins": [
    {
      "name": "postgres",
      "kind": "external",
      "hosts": ["claude"],
      "claudeEntry": {
        "name": "postgres",
        "source": {
          "source": "github",
          "repo": "bonboncinnabon/postgres-mcp"
        },
        "description": "PostgreSQL database access with health diagnostics, slow query analysis, and connection monitoring",
        "category": "database",
        "homepage": "https://github.com/bonboncinnabon/postgres-mcp",
        "tags": ["postgresql", "database", "mcp", "diagnostics"]
      }
    },
    {
      "name": "devlab",
      "kind": "local",
      "path": "./plugins/devlab",
      "hosts": ["claude", "codex"]
    },
    {
      "name": "butler",
      "kind": "local",
      "path": "./plugins/butler",
      "hosts": ["claude", "codex"]
    },
    {
      "name": "standards",
      "kind": "local",
      "path": "./plugins/standards",
      "hosts": ["claude", "codex"]
    },
    {
      "name": "gaming",
      "kind": "local",
      "path": "./plugins/gaming",
      "hosts": ["claude", "codex"]
    }
  ]
}
